{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folk-job-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folk-job",
      "database_id": "fd222d9f-1c87-4fd9-a439-f4c0cf9017e1",
      "remote": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["jobhub@islumi.com"],
      "remote": true
    }
  ],
  "vars": {
    "NEW_API_BASE_URL": "https://mediocre-new-api.midway.run/v1/chat/completions"
  },
  "secrets": {
    "required": ["TIKHUB_API_KEY", "INGEST_TOKEN", "NEW_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
