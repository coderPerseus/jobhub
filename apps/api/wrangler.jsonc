{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folk-job-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folk-job",
      "database_id": "fd222d9f-1c87-4fd9-a439-f4c0cf9017e1",
      "remote": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["jobhub@islumi.com"],
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "OCR",
      "service": "jobhub-ocr",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ENRICHMENT_QUEUE",
        "queue": "jobhub-enrichment"
      }
    ],
    "consumers": [
      {
        "queue": "jobhub-enrichment",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_concurrency": 10,
        "max_retries": 3,
        "dead_letter_queue": "jobhub-enrichment-dlq"
      }
    ]
  },
  "vars": {
    "NEW_API_BASE_URL": "https://mediocre-new-api.midway.run/v1/chat/completions",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com/beta/chat/completions",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "secrets": {
    "required": ["TIKHUB_API_KEY", "INGEST_TOKEN", "NEW_API_KEY", "DEEPSEEK_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
